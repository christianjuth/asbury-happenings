{
  "name": "chaotic-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/sensible": "^6.0.0",
    "cheerio": "^1.0.0",
    "dayjs": "^1.11.13",
    "fastify": "^5.0.0",
    "ical-generator": "^8.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "supportedArchitectures": {
      "os": ["current", "darwin", "linux"],
      "cpu": ["current", "x64", "arm64"],
      "libc": ["current", "glibc", "musl"]
    }
  }
}
