{
  "name": "@repo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "dev:workspace": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "build:workspace": "pnpm run build",
    "start": "node dist/main.js",
    "lint": "pnpm run lint:workspace",
    "lint:workspace": "eslint src test",
    "lint:dead": "pnpm run lint:dead:workspace",
    "lint:dead:workspace": "knip",
    "test": "pnpm run test:workspace",
    "test:workspace": "vitest run",
    "test:watch": "vitest",
    "test:ts": "pnpm run test:ts:workspace",
    "test:ts:workspace": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/sensible": "^6.0.0",
    "bottleneck": "2.19.5",
    "cheerio": "^1.0.0",
    "dayjs": "^1.11.13",
    "fastify": "^5.0.0",
    "ical-generator": "^8.0.0",
    "lodash": "4.18.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@types/lodash": "4.17.24",
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^10.6.0",
    "eslint-plugin-import-x": "4.17.1",
    "knip": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
