{
  "name": "chaotic-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm lint:types && pnpm lint:eslint",
    "lint:eslint": "eslint src test",
    "lint:cycles": "pnpm lint:eslint",
    "lint:types": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/sensible": "^6.0.0",
    "bottleneck": "2.19.5",
    "cheerio": "^1.0.0",
    "dayjs": "^1.11.13",
    "fastify": "^5.0.0",
    "ical-generator": "^8.0.0",
    "lodash": "4.18.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/lodash": "4.17.24",
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^10.6.0",
    "eslint-plugin-import-x": "4.17.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current",
        "darwin",
        "linux"
      ],
      "cpu": [
        "current",
        "x64",
        "arm64"
      ],
      "libc": [
        "current",
        "glibc",
        "musl"
      ]
    }
  }
}
