{
  "name": "@repo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --port 3100",
    "dev:workspace": "vite --port ${PORT:-3100}",
    "build": "tsc -b && vite build",
    "build:workspace": "pnpm run build",
    "lint": "pnpm run lint:workspace",
    "lint:workspace": "eslint src",
    "lint:dead": "pnpm run lint:dead:workspace",
    "lint:dead:workspace": "knip",
    "preview": "vite preview",
    "test": "pnpm run test:workspace",
    "test:workspace": "vitest run",
    "test:watch": "vitest",
    "test:ts": "pnpm run test:ts:workspace",
    "test:ts:workspace": "tsc -b --pretty false"
  },
  "dependencies": {
    "@mantine/core": "9.5.2",
    "@mantine/dates": "9.5.2",
    "@mantine/hooks": "9.5.2",
    "@mantine/schedule": "9.5.2",
    "dayjs": "1.11.23",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@repo/eslint-config": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^10.0.0",
    "eslint-import-resolver-typescript": "^4.0.0",
    "eslint-plugin-import-x": "^4.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "knip": "^5.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.1.7",
    "vitest": "^2.1.0"
  }
}
